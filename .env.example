# Copy to .env and uncomment what you need.

# Where account files are stored (default: ~/.config/whatsapp-templates).
# Keep this folder outside the project: every file in it holds an access token.
# WHATSAPP_TEMPLATES_DIR=/absolute/path/to/accounts

# Serve a fictional store instead of calling Meta (same as `bun run demo`).
# WHATSAPP_TEMPLATES_DEMO=true

# Ask GitHub once a day whether a new version is out (shown in the footer).
# WHATSAPP_TEMPLATES_UPDATE_CHECK=false

# Extra names the app may be opened with, comma separated, such as a local HTTPS proxy.
# 127.0.0.1, localhost and any name ending in .localhost always work.
# WHATSAPP_TEMPLATES_HOSTS=whatsapp.test
